---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {CHANNEL_LABELS, CHANNELS, loadProject, PROJECTS, projectPath} from '../lib/downloads';

export const prerender = false;

const results = await Promise.all(PROJECTS.map(loadProject));
const plex = results.find((result) => result.name === 'Plex');
const modules = results.filter((result) => result.name !== 'Plex');

// Stable leads when any project publishes it, so it is also the default tab.
const stocked = CHANNELS.filter((channel) => results.some((result) => result.channels?.[channel]));
const requestedChannel = Astro.url.searchParams.get('channel') ?? '';
const activeChannel = CHANNELS.includes(requestedChannel) ? requestedChannel : stocked[0] ?? 'stable';
---

<StarlightPage frontmatter={{title: 'Downloads', description: 'Download stable and dev builds of Plex and its modules.', tableOfContents: false, prev: false, next: false}}>
    <div id="plex-downloads" class="not-content">
        <p class="dl-lede">
            Every build comes from the official <a href="https://ci.plex.us.org">Plexus CI</a>.
            The stable channel has release builds. The dev channel has the latest snapshot builds.
        </p>

        <nav class="dl-tabs" aria-label="Build channel">
            {CHANNELS.map((channel) => (
                <a
                    class="dl-tab"
                    href={`?channel=${channel}`}
                    aria-current={channel === activeChannel ? 'page' : undefined}
                >{CHANNEL_LABELS[channel]}</a>
            ))}
        </nav>

        {plex && (
            <section aria-labelledby="dl-plex-heading">
                <div class="dl-section-head">
                    <h2 id="dl-plex-heading">Plex</h2>
                    <a class="dl-more" href={projectPath(plex.name, activeChannel)}>
                        All builds
                        <svg
                            class="dl-more-icon"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="m9 18 6-6-6-6"/>
                        </svg>
                    </a>
                </div>
                <ProjectCard project={plex} channel={activeChannel} featured/>
            </section>
        )}

        <div class="dl-cut" aria-hidden="true"></div>

        <section aria-labelledby="dl-modules-heading">
            <h2 id="dl-modules-heading">Modules</h2>
            <p class="dl-section-sub">
                Modules are optional. Each one ships its own stable and dev builds.
            </p>
            <ul class="dl-list">
                {modules.map((project) => <ProjectCard project={project} channel={activeChannel}/>)}
            </ul>
        </section>
    </div>
</StarlightPage>

<style is:global>
    /* Design tokens, mapped onto Starlight so both themes keep working. */
    #plex-downloads {
        --dl-surface: var(--sl-color-gray-6);
        --dl-edge: var(--sl-color-gray-5);
        --dl-edge-hover: var(--sl-color-gray-4);
        --dl-fog: var(--sl-color-gray-3);
        --dl-paper: var(--sl-color-white);
        --dl-steel: var(--sl-color-text-accent);
        --dl-radius: 0.5rem;
        --dl-radius-sm: 0.375rem;
    }

    #plex-downloads a:focus-visible {
        outline: 2px solid var(--dl-steel);
        outline-offset: 2px;
    }

    /* Page intro and sections */

    #plex-downloads .dl-lede {
        margin: 0 0 2rem;
        max-width: 42rem;
        color: var(--dl-fog);
        text-wrap: pretty;
    }

    #plex-downloads .dl-tabs {
        display: flex;
        gap: 1.75rem;
        margin: 0 0 2.5rem;
        border-bottom: 1px solid var(--dl-edge);
    }

    #plex-downloads .dl-tab {
        margin-bottom: -1px;
        padding-bottom: 0.6rem;
        border-bottom: 2px solid transparent;
        font-size: var(--sl-text-sm);
        color: var(--dl-fog);
        text-decoration: none;
        transition: color 150ms ease, border-color 150ms ease;
    }

    #plex-downloads .dl-tab:hover {
        color: var(--dl-paper);
    }

    #plex-downloads .dl-tab[aria-current='page'] {
        color: var(--dl-paper);
        border-bottom-color: var(--dl-steel);
    }

    #plex-downloads .dl-lede a {
        color: var(--dl-steel);
        transition: color 150ms ease;
    }

    #plex-downloads .dl-lede a:hover {
        color: var(--dl-paper);
    }

    #plex-downloads h2 {
        margin: 0;
        font-size: var(--sl-text-xl);
        font-weight: 500;
        line-height: var(--sl-line-height-headings);
        color: var(--dl-paper);
        text-wrap: balance;
    }

    #plex-downloads .dl-section-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
    }

    #plex-downloads .dl-section-sub {
        margin: 0.5rem 0 0;
        max-width: 42rem;
        font-size: var(--sl-text-sm);
        color: var(--dl-fog);
    }

    #plex-downloads .dl-more {
        display: inline-flex;
        flex: none;
        align-items: center;
        gap: 0.25rem;
        font-size: var(--sl-text-sm);
        color: var(--dl-fog);
        text-decoration: none;
        transition: color 150ms ease;
    }

    #plex-downloads .dl-more:hover {
        color: var(--dl-paper);
    }

    #plex-downloads .dl-more-icon {
        width: 0.9rem;
        height: 0.9rem;
    }

    #plex-downloads .dl-cut {
        margin: 3rem 0;
        border-top: 1px dashed var(--dl-edge);
    }

    /* Featured Plex card */

    #plex-downloads .dl-featured {
        margin-top: 1rem;
    }

    #plex-downloads .dl-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.25rem;
        border: 1px solid var(--dl-edge);
        border-radius: var(--dl-radius);
        background: var(--dl-surface);
        color: var(--sl-color-text);
        text-decoration: none;
        transition: border-color 150ms ease;
    }

    #plex-downloads .dl-card:hover {
        border-color: var(--dl-edge-hover);
    }

    #plex-downloads .dl-card-main {
        display: block;
        min-width: 0;
    }

    #plex-downloads .dl-version {
        display: block;
        font-size: var(--sl-text-2xl);
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.15;
        color: var(--dl-paper);
        font-variant-numeric: tabular-nums;
    }

    #plex-downloads .dl-card-meta {
        display: block;
        margin-top: 0.35rem;
        font-size: var(--sl-text-xs);
        color: var(--dl-fog);
        font-variant-numeric: tabular-nums;
    }

    #plex-downloads .dl-card-action {
        display: inline-flex;
        flex: none;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--sl-text-sm);
        color: var(--dl-steel);
        transition: color 150ms ease;
    }

    #plex-downloads .dl-card:hover .dl-card-action {
        color: var(--dl-paper);
    }

    #plex-downloads .dl-card-icon {
        width: 1.25rem;
        height: 1.25rem;
        transition: transform 150ms ease;
    }

    #plex-downloads .dl-card:hover .dl-card-icon {
        transform: translateY(1px);
    }

    #plex-downloads .dl-card-empty {
        display: flex;
        align-items: center;
        margin: 0;
        padding: 1.25rem;
        border: 1px dashed var(--dl-edge);
        border-radius: var(--dl-radius);
        font-size: var(--sl-text-sm);
        color: var(--dl-fog);
    }

    /* Module list */

    #plex-downloads .dl-list {
        list-style: none;
        margin: 1rem 0 0;
        padding: 0;
        border: 1px solid var(--dl-edge);
        border-radius: var(--dl-radius);
        background: var(--dl-surface);
    }

    #plex-downloads .dl-row {
        padding: 1rem 1.25rem;
    }

    #plex-downloads .dl-row + .dl-row {
        border-top: 1px solid var(--dl-edge);
    }

    #plex-downloads .dl-row-main {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
    }

    #plex-downloads .dl-module-name {
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--dl-paper);
    }

    #plex-downloads .dl-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.5rem;
    }

    #plex-downloads .dl-action {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--sl-text-sm);
        color: var(--dl-steel);
        text-decoration: none;
        transition: color 150ms ease;
    }

    #plex-downloads .dl-action:hover {
        color: var(--dl-paper);
    }

    #plex-downloads .dl-action-version {
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    #plex-downloads .dl-action-icon {
        width: 1rem;
        height: 1rem;
        transition: transform 150ms ease;
    }

    #plex-downloads .dl-action:hover .dl-action-icon {
        transform: translateY(1px);
    }

    #plex-downloads .dl-action-empty,
    #plex-downloads .dl-row-note {
        font-size: var(--sl-text-sm);
        color: var(--dl-fog);
    }

    #plex-downloads .dl-row-note a {
        color: var(--dl-steel);
        text-decoration: none;
        transition: color 150ms ease;
    }

    #plex-downloads .dl-row-note a:hover {
        color: var(--dl-paper);
    }

    /* Error and empty notices */

    #plex-downloads .dl-note {
        margin: 1rem 0 0;
        padding: 1rem;
        border: 1px solid var(--dl-edge);
        border-radius: var(--dl-radius-sm);
        background: var(--dl-surface);
        font-size: var(--sl-text-sm);
        color: var(--dl-fog);
    }

    #plex-downloads .dl-note a {
        color: var(--dl-steel);
        text-decoration: none;
        transition: color 150ms ease;
    }

    #plex-downloads .dl-note a:hover {
        color: var(--dl-paper);
    }

    @media (prefers-reduced-motion: reduce) {
        #plex-downloads .dl-card-icon,
        #plex-downloads .dl-action-icon {
            transition: color 150ms ease;
        }

        #plex-downloads .dl-card:hover .dl-card-icon,
        #plex-downloads .dl-action:hover .dl-action-icon {
            transform: none;
        }
    }
</style>
