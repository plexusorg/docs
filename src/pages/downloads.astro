---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {CHANNEL_LABELS, CHANNELS, loadProject, PROJECTS, projectPath} from '../lib/downloads';

export const prerender = false;

const results = await Promise.all(PROJECTS.map(loadProject));
const plex = results.find((result) => result.name === 'Plex');
const modules = results.filter((result) => result.name !== 'Plex');

// Stable leads when any project publishes it, so it is also the default tab.
const stocked = CHANNELS.filter((channel) => results.some((result) => result.channels?.[channel]));
const requestedChannel = Astro.url.searchParams.get('channel') ?? '';
const activeChannel = CHANNELS.includes(requestedChannel) ? requestedChannel : stocked[0] ?? 'stable';
---

<StarlightPage frontmatter={{title: 'Downloads', description: 'Download stable and dev builds of Plex and its modules.', tableOfContents: false, prev: false, next: false}}>
    <div id="plex-downloads" class="not-content">
        <p class="dl-lede">
            Every build comes from the official <a href="https://ci.plex.us.org">Plexus CI</a>.
            The stable channel has release builds. The dev channel has the latest snapshot builds.
        </p>

        <nav class="dl-tabs" aria-label="Build channel">
            {CHANNELS.map((channel) => (
                <a
                    class="dl-tab"
                    href={`?channel=${channel}`}
                    aria-current={channel === activeChannel ? 'page' : undefined}
                >{CHANNEL_LABELS[channel]}</a>
            ))}
        </nav>

        {plex && (
            <section class="dl-section" aria-labelledby="dl-plex-heading">
                <div class="dl-section-head">
                    <h2 id="dl-plex-heading">Plex</h2>
                    <a class="dl-more" href={projectPath(plex.name, activeChannel)}>
                        All builds
                        <svg
                            class="dl-more-icon"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="m9 18 6-6-6-6"/>
                        </svg>
                    </a>
                </div>
                <ProjectCard project={plex} channel={activeChannel} featured/>
            </section>
        )}

        <section class="dl-section" aria-labelledby="dl-modules-heading">
            <div class="dl-section-head">
                <h2 id="dl-modules-heading">Modules</h2>
            </div>
            <p class="dl-section-sub">
                Modules are optional. Each one ships its own stable and dev builds.
            </p>
            <ul class="dl-list">
                {modules.map((project) => <ProjectCard project={project} channel={activeChannel}/>)}
            </ul>
        </section>
    </div>
</StarlightPage>

<style is:global>
    /* Colors come from the --plex-* tokens in src/styles/custom.css, so both themes work. */

    #plex-downloads .dl-lede {
        margin: 0 0 2rem;
        font-size: var(--sl-text-lg);
        color: var(--plex-body);
    }

    #plex-downloads .dl-lede a,
    #plex-downloads .dl-note a,
    #plex-downloads .dl-row-note a {
        color: var(--plex-link);
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
        text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
        transition: color 150ms ease;
    }

    #plex-downloads .dl-lede a:hover,
    #plex-downloads .dl-note a:hover,
    #plex-downloads .dl-row-note a:hover {
        color: var(--plex-heading);
        text-decoration-color: currentColor;
    }

    /* Channel tabs */

    #plex-downloads .dl-tabs {
        display: flex;
        gap: 1.75rem;
        margin: 0;
        border-bottom: 1px solid var(--plex-line);
    }

    #plex-downloads .dl-tab {
        margin-bottom: -1px;
        padding-bottom: 0.6rem;
        border-bottom: 2px solid transparent;
        font-size: 0.9375rem;
        font-weight: 500;
        color: var(--plex-muted);
        text-decoration: none;
        transition: color 150ms ease;
    }

    #plex-downloads .dl-tab:hover {
        color: var(--plex-heading);
    }

    #plex-downloads .dl-tab[aria-current='page'] {
        color: var(--plex-heading);
        font-weight: 600;
        border-bottom-color: var(--plex-tick);
    }

    /* Sections: the margin tick, the heading, then the "All builds" link at the end of the row. */

    #plex-downloads .dl-section {
        margin-top: 3rem;
    }

    #plex-downloads .dl-section-head {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    #plex-downloads .dl-section-head::before {
        content: '';
        flex: none;
        width: 8px;
        height: 8px;
        background-color: var(--plex-tick);
    }

    #plex-downloads h2 {
        margin: 0;
        font-size: var(--sl-text-h2);
        font-weight: 700;
        font-stretch: 112.5%;
        letter-spacing: -0.015em;
        line-height: var(--sl-line-height-headings);
        color: var(--plex-heading);
    }

    #plex-downloads .dl-section-sub {
        margin: 0.5rem 0 0;
        font-size: var(--sl-text-sm);
        color: var(--plex-muted);
    }

    #plex-downloads .dl-more {
        display: inline-flex;
        flex: none;
        margin-inline-start: auto;
        align-items: center;
        gap: 0.25rem;
        font-size: var(--sl-text-sm);
        font-weight: 500;
        color: var(--plex-muted);
        text-decoration: none;
        transition: color 150ms ease;
    }

    #plex-downloads .dl-more:hover {
        color: var(--plex-heading);
    }

    #plex-downloads .dl-more-icon {
        width: 0.9rem;
        height: 0.9rem;
    }

    /* Featured Plex build */

    #plex-downloads .dl-featured {
        margin-top: 1.25rem;
    }

    #plex-downloads .dl-card {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem 1.5rem;
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--plex-line);
        border-radius: 6px;
        color: var(--plex-body);
        text-decoration: none;
        transition: border-color 150ms ease;
    }

    #plex-downloads .dl-card:hover {
        border-color: var(--plex-muted);
    }

    #plex-downloads .dl-card-main {
        display: block;
        min-width: 0;
    }

    #plex-downloads .dl-version {
        display: block;
        font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.25rem);
        font-weight: 800;
        font-stretch: 125%;
        letter-spacing: -0.02em;
        line-height: 1.1;
        color: var(--plex-heading);
        font-variant-numeric: tabular-nums;
        overflow-wrap: anywhere;
    }

    #plex-downloads .dl-card-meta {
        display: block;
        margin-top: 0.5rem;
        font-size: var(--sl-text-sm);
        color: var(--plex-muted);
        font-variant-numeric: tabular-nums;
    }

    #plex-downloads .dl-card-action {
        display: inline-flex;
        flex: none;
        align-items: center;
        gap: 0.45rem;
        font-weight: 600;
        color: var(--plex-link);
        transition: color 150ms ease;
    }

    #plex-downloads .dl-card:hover .dl-card-action {
        color: var(--plex-heading);
    }

    #plex-downloads .dl-card-icon {
        width: 1.25rem;
        height: 1.25rem;
        transition: transform 150ms ease;
    }

    #plex-downloads .dl-card:hover .dl-card-icon {
        transform: translateY(1px);
    }

    #plex-downloads .dl-card-empty {
        margin: 0;
        padding: 1.25rem 1.5rem;
        border: 1px dashed var(--plex-line);
        border-radius: 6px;
        font-size: var(--sl-text-sm);
        color: var(--plex-muted);
    }

    /* Module list: one line between rows, no frame above or below. */

    #plex-downloads .dl-list {
        list-style: none;
        margin: 0.5rem 0 0;
        padding: 0;
    }

    #plex-downloads .dl-row {
        padding: 1rem 0;
    }

    #plex-downloads .dl-row + .dl-row {
        border-top: 1px solid var(--plex-line);
    }

    #plex-downloads .dl-row-main {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.5rem 1.5rem;
    }

    #plex-downloads .dl-module-name {
        font-weight: 600;
        color: var(--plex-heading);
    }

    #plex-downloads .dl-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 1.5rem;
    }

    #plex-downloads .dl-action {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-size: var(--sl-text-sm);
        color: var(--plex-link);
        text-decoration: none;
        transition: color 150ms ease;
    }

    #plex-downloads .dl-action:hover {
        color: var(--plex-heading);
    }

    #plex-downloads .dl-action-version {
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    #plex-downloads .dl-action-icon {
        width: 1rem;
        height: 1rem;
        transition: transform 150ms ease;
    }

    #plex-downloads .dl-action:hover .dl-action-icon {
        transform: translateY(1px);
    }

    #plex-downloads .dl-action-empty,
    #plex-downloads .dl-row-note {
        font-size: var(--sl-text-sm);
        color: var(--plex-muted);
    }

    /* Error notice */

    #plex-downloads .dl-note {
        margin: 1rem 0 0;
        padding: 1rem 1.25rem;
        border-radius: 6px;
        background-color: var(--plex-surface);
        font-size: var(--sl-text-sm);
        color: var(--plex-muted);
    }

    @media (prefers-reduced-motion: reduce) {
        #plex-downloads :is(.dl-lede a, .dl-note a, .dl-row-note a, .dl-tab, .dl-more, .dl-card, .dl-card-action,
            .dl-card-icon, .dl-action, .dl-action-icon) {
            transition: none;
        }

        #plex-downloads .dl-card:hover .dl-card-icon,
        #plex-downloads .dl-action:hover .dl-action-icon {
            transform: none;
        }
    }
</style>