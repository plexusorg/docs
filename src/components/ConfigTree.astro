import ConfigNode from './ConfigNode.astro';
import {configFiles, type ConfigFileName, type TreeNode} from '../data/reference';
import './reference.css';

interface Props {
    file: ConfigFileName;
    /** The top-level keys of the file that this section shows, separated by spaces. */
    keys: string;
}

const {file, keys} = Astro.props;
const wanted = keys.split(/\s+/);
const picked = configFiles[file].nodes.filter((node) => wanted.includes(node.key));

// A section with one top-level map is named by its heading, so its settings start at the first level.
const nodes: TreeNode[] = picked.length === 1 && picked[0].kind === 'branch' ? picked[0].children : picked;

// The key column fits the longest key with its indent, so every value in the section starts at the same place.
const longest = new Map<number, number>();
const measure = (list: TreeNode[], depth: number) => {
    for (const node of list) {
        longest.set(depth, Math.max(longest.get(depth) ?? 0, node.key.length));
        if (node.kind === 'branch') {
            measure(node.children, depth + 1);
        }
    }
};
measure(nodes, 0);
const keyColumn = `max(${[...longest].map(([depth, length]) =>
    `calc(${length + 1}ch + var(--ref-gutter) + ${depth} * var(--ref-indent))`).join(', ')})`;
---

<div class="ref ref-config not-content" data-ref translate="no" style={`--ref-key-col: ${keyColumn}`}>
    <ConfigNode nodes={nodes} depth={0} />
</div>

<script>
    import './reference-tree.ts';
</script>
