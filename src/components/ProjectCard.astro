---
import {CHANNEL_LABELS, displayName, formatDate, jenkinsUrl, projectPath} from '../lib/downloads';

const {project, featured = false, channel} = Astro.props;

const build = project.error ? null : project.channels?.[channel];
const label = (CHANNEL_LABELS[channel] ?? channel).toLowerCase();

function cardMeta(entry) {
    const parts = [];
    if (entry.minecraftVersions?.length) {
        parts.push(`Minecraft ${entry.minecraftVersions.join(', ')}`);
    }
    parts.push(`Build ${entry.buildNumber}`, formatDate(entry.publishedAt));
    return parts.join(' · ');
}

const downloadLabel = build
    ? `Download ${displayName(project.name)} ${build.version} (${label})`
    : undefined;
const shaTitle = build?.sha256 ? `SHA-256 ${build.sha256}` : undefined;
---

{featured ? (
    <div class="dl-featured">
        {project.error ? (
            <p class="dl-note">
                The build data did not load. Use <a href={jenkinsUrl(project)}>Jenkins</a> to get the files.
            </p>
        ) : build ? (
            <a class="dl-card" href={build.downloadUrl} title={shaTitle} aria-label={downloadLabel}>
                <span class="dl-card-main">
                    <span class="dl-version">{build.version}</span>
                    <span class="dl-card-meta">{cardMeta(build)}</span>
                </span>
                <span class="dl-card-action">
                    Download
                    <svg
                        class="dl-card-icon"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M12 4v11"/>
                        <path d="m7 11 5 5 5-5"/>
                        <path d="M5 20h14"/>
                    </svg>
                </span>
            </a>
        ) : (
            <p class="dl-card-empty">No {label} build yet</p>
        )}
    </div>
) : (
    <li class="dl-row">
        <div class="dl-row-main">
            <span class="dl-module-name">{displayName(project.name)}</span>
            {project.error ? (
                <span class="dl-row-note">
                    The build data did not load. Use <a href={jenkinsUrl(project)}>Jenkins</a>.
                </span>
            ) : (
                <div class="dl-actions">
                    {build ? (
                        <a class="dl-action" href={build.downloadUrl} title={shaTitle} aria-label={downloadLabel}>
                            <span class="dl-action-version">{build.version}</span>
                            <svg
                                class="dl-action-icon"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M12 4v11"/>
                                <path d="m7 11 5 5 5-5"/>
                                <path d="M5 20h14"/>
                            </svg>
                        </a>
                    ) : (
                        <span class="dl-action-empty">No {label} build yet</span>
                    )}
                    <a class="dl-more" href={projectPath(project.name, channel)}>
                        All builds
                        <svg
                            class="dl-more-icon"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                        >
                            <path d="m9 18 6-6-6-6"/>
                        </svg>
                    </a>
                </div>
            )}
        </div>
    </li>
)}
